{
  "name": "rabbithole_explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight 2D map of public live 'what's around me' data, with a personal RTL-SDR overlay.",
  "license": "MIT",
  "author": "RafailDD",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gateways": "node tools/fetch-gateways.mjs",
    "streams": "node tools/check-streams.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "satellite.js": "7.1.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
